# ===========================================
# YOLO Training Visualization Platform
# Frontend Dockerfile (Multi-stage build)
# ===========================================

# ========== 构建阶段 ==========
FROM node:20-alpine AS builder

WORKDIR /app

# 复制依赖文件
COPY frontend/package.json frontend/yarn.lock ./

# 安装依赖
RUN yarn install --frozen-lockfile

# 复制源代码
COPY frontend/ .

# 设置构建时环境变量
ARG VITE_API_BASE_URL=http://localhost:10799
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# 构建生产版本
RUN yarn build

# ========== 运行阶段 ==========
FROM nginx:alpine

LABEL maintainer="YOLO Training Platform"
LABEL description="Frontend service for YOLO Training Visualization Platform"

# 复制构建产物
COPY --from=builder /app/dist /usr/share/nginx/html

# 复制 Nginx 配置
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# 暴露端口
EXPOSE 80

# 启动 Nginx
CMD ["nginx", "-g", "daemon off;"]
