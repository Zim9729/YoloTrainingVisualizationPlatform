{
  "name": "yolo_training_visualization_app",
  "version": "1.0.0",
  "description": "YOLO Training Visualization Platform - A comprehensive tool for YOLO model training, testing, and visualization",
  "main": "index.js",
  "repository": "https://github.com/chzane/YoloTrainingVisualizationPlatform/",
  "author": "chzane",
  "build": {
    "appId": "com.solariix.yolo_training_visualization_app",
    "productName": "YoloTrainingVisualizationApp",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.js",
      "preload.js",
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*",
          "!**/.venv/**",
          "!**/build/**",
          "!**/dist/**",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "dir",
      "requestedExecutionLevel": "asInvoker"
    },
    "asarUnpack": [
      "resources/backend/**"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "resources/backend",
        "filter": [
          "**/*",
          "!**/.venv/**",
          "!**/build/**",
          "!**/dist/**",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ]
  },
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "build:dir": "electron-builder --dir",
    "build:win": "electron-builder --win --x64",
    "build:fix": "powershell -ExecutionPolicy Bypass -File build-fix.ps1",
    "build:clean": "powershell -ExecutionPolicy Bypass -File build-fix.ps1 -Clean"
  },
  "license": "MIT",
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "python-shell": "^5.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-deb": "^7.8.1",
    "@electron-forge/maker-rpm": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.1",
    "@electron-forge/plugin-fuses": "^7.8.1",
    "@electron/fuses": "^1.8.0",
    "babel-runtime": "^6.26.0",
    "electron": "^37.2.1",
    "electron-builder": "^26.0.12"
  }
}