# ===========================================
# YOLO Training Visualization Platform
# Docker 环境变量配置文件
# ===========================================
# 使用方法:
#   1. 复制此文件为 .env: cp .env.example .env
#   2. 修改下方配置为您的实际地址
#   3. 运行: docker-compose up -d
# ===========================================

# ========== 前端 API 地址 ==========
# 前端访问后端的地址（构建时注入）
# 如果前端和后端在同一服务器，使用服务器 IP 或域名
VITE_API_BASE_URL=http://localhost:10799

# ========== TCP 图像处理服务 ==========
# C++ TCP 图像处理服务器地址
TCP_IMAGE_SERVICE_HOST=192.168.1.100
TCP_IMAGE_SERVICE_PORT=16000

# ========== Triton 推理服务 ==========
# NVIDIA Triton Inference Server 地址
TRITON_SERVER_HOST=192.168.1.100
TRITON_SERVER_PORT=8000

# ========== Label Studio 标注服务 ==========
# Label Studio 服务器地址
LABEL_STUDIO_HOST=192.168.1.100
LABEL_STUDIO_PORT=8080
# Label Studio API Token (从 Label Studio 设置页面获取)
LABEL_STUDIO_API_TOKEN=Token your_api_token_here
